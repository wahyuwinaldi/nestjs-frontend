# ==============================
# API Template - example environment (copy to .env.development)
# ==============================

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=01082025
DB_NAME=base_project
DB_SCHEMA=public

# --- Security (generate your own random values for production!) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
APP_KEY=change-me
API_TOKEN=change-me
COOKIE_SECRET=change-me
AES_KEY=change-me

# --- App server ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Password policy ---
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_COUNT=3
LOCKOUT_THRESHOLD=5
PASSWORD_RESET_TTL_HOURS=1
ADMIN_PASSWORD_RESET_TTL_HOURS=24
EXPIRED_CHANGE_TOKEN_TTL_MINUTES=15

# --- Uploads ---
UPLOAD_DIR=uploads

# --- MinIO ---
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=
MINIO_BUCKET=template-uploads
MINIO_PUBLIC_URL=
MINIO_SKIP_STARTUP_CHECK=false
MINIO_STARTUP_TIMEOUT=8000

# --- SMTP / email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
