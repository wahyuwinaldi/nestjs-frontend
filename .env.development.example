# ==============================
# Dashboard Template - development environment (example)
# ==============================

# Nest API via Vite proxy `/api` → http://localhost:3000 (prefix di-strip)
VITE_API_BASE_URL=/api

# Sent as the `x-api-key` header on every request. Must match the backend's
# API_TOKEN value.
VITE_APP_KEY=change-me

# Local-only secret used to AES-encrypt session/menu/akses in localStorage.
# Must be exactly 32 characters. Not related to the backend's AES_KEY.
VITE_ENCRYPTION_SECRET_KEY=changeme-encryption-secret-32chr
